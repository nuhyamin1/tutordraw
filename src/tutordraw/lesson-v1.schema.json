{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "TutorDraw lesson schema v1",
  "description": "Structural validation only. TutorDraw also checks cross-references, identities and the embedded DrawCV document.",
  "type": "object",
  "properties": {
    "format": {
      "const": "tutordraw.lesson"
    },
    "schema_version": {
      "type": "integer",
      "const": 1
    },
    "title": {
      "type": "string"
    },
    "theme": {
      "$ref": "#/$defs/theme"
    },
    "scene": {
      "type": "object"
    },
    "targets": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/target"
      }
    },
    "labels": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/label"
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/step"
      }
    }
  },
  "required": [
    "format",
    "schema_version",
    "title",
    "theme",
    "scene",
    "targets",
    "labels",
    "steps"
  ],
  "additionalProperties": false,
  "$defs": {
    "id": {
      "type": "string",
      "minLength": 1,
      "pattern": "\\S"
    },
    "theme": {
      "type": "object",
      "properties": {
        "text_color": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3
        },
        "panel_color": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3
        },
        "border_color": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3
        },
        "leader_color": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3
        },
        "highlight_color": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3
        },
        "font_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "padding": {
          "type": "number",
          "minimum": 0
        },
        "gap": {
          "type": "number",
          "minimum": 0
        },
        "leader_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "border_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "highlight_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "highlight_padding": {
          "type": "number",
          "minimum": 0
        },
        "callout_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "line_spacing": {
          "type": "number",
          "minimum": 1
        },
        "dim_opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "text_color",
        "panel_color",
        "border_color",
        "leader_color",
        "highlight_color",
        "font_scale",
        "padding",
        "gap",
        "leader_width",
        "border_width",
        "highlight_width",
        "highlight_padding",
        "callout_width",
        "line_spacing",
        "dim_opacity"
      ],
      "additionalProperties": false
    },
    "target": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "drawable_id": {
          "$ref": "#/$defs/id"
        },
        "name": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1,
              "pattern": "\\S"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "drawable_id",
        "name"
      ],
      "additionalProperties": false
    },
    "label": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "target_id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[\\x20-\\x7E]+$"
        },
        "anchor": {
          "enum": [
            "left",
            "right",
            "top",
            "bottom",
            "center"
          ]
        },
        "leader": {
          "type": "boolean"
        },
        "gap": {
          "type": "number",
          "minimum": 0
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "font_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "padding": {
          "type": "number",
          "minimum": 0
        }
      },
      "required": [
        "id",
        "target_id",
        "text",
        "anchor",
        "leader",
        "gap",
        "offset",
        "font_scale",
        "padding"
      ],
      "additionalProperties": false
    },
    "callout": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "target_id": {
          "$ref": "#/$defs/id"
        },
        "text": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[\\x20-\\x7E\\n]+$"
        },
        "anchor": {
          "enum": [
            "left",
            "right",
            "top",
            "bottom",
            "center"
          ]
        },
        "leader": {
          "type": "boolean"
        },
        "gap": {
          "type": "number",
          "minimum": 0
        },
        "offset": {
          "type": "array",
          "items": {
            "type": "number"
          },
          "minItems": 2,
          "maxItems": 2
        },
        "font_scale": {
          "type": "number",
          "exclusiveMinimum": 0,
          "maximum": 10
        },
        "padding": {
          "type": "number",
          "minimum": 0
        },
        "max_width": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "line_spacing": {
          "type": "number",
          "minimum": 1
        }
      },
      "required": [
        "id",
        "target_id",
        "text",
        "anchor",
        "leader",
        "gap",
        "offset",
        "font_scale",
        "padding",
        "max_width",
        "line_spacing"
      ],
      "additionalProperties": false
    },
    "highlight": {
      "type": "object",
      "properties": {
        "target_id": {
          "$ref": "#/$defs/id"
        },
        "padding": {
          "type": "number",
          "minimum": 0
        },
        "color": {
          "type": "array",
          "items": {
            "type": "integer",
            "minimum": 0,
            "maximum": 255
          },
          "minItems": 3,
          "maxItems": 3
        },
        "width": {
          "type": "number",
          "exclusiveMinimum": 0
        }
      },
      "required": [
        "target_id",
        "padding",
        "color",
        "width"
      ],
      "additionalProperties": false
    },
    "dim": {
      "type": "object",
      "properties": {
        "target_ids": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "minItems": 1,
          "uniqueItems": true
        },
        "opacity": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      },
      "required": [
        "target_ids",
        "opacity"
      ],
      "additionalProperties": false
    },
    "step": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/id"
        },
        "title": {
          "type": "string",
          "minLength": 1,
          "pattern": "\\S"
        },
        "labels": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/id"
          },
          "uniqueItems": true
        },
        "callouts": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/callout"
          }
        },
        "highlights": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/highlight"
          }
        },
        "dim": {
          "anyOf": [
            {
              "$ref": "#/$defs/dim"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "id",
        "title",
        "labels",
        "callouts",
        "highlights",
        "dim"
      ],
      "additionalProperties": false
    }
  }
}
